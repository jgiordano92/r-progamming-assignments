#3. Explore S3 vs S4

#Create an S3 object example:
s3_obj <- list(name = "Myself", age = 29, GPA = 3.5)
class(s3_obj) <- "student_s3"
#Create an S4 class and object example:
setClass("student_s4",
  slots = c(name = "character", age = "numeric", GPA = "numeric"))
s4_obj <- new("student_s4", name = "Myself", age = 29, GPA = 3.5)
#Demonstrate a generic function dispatch for each (e.g., write simple print methods).
#s3
print.student_s3 <- function(x) {
+     cat("Student Name:", x$name, "\n")
+     cat("Age:", x$age, "\n")
+     cat("GPA:", x$GPA, "\n")
+ }
> print(s3_obj)
#s4
> setMethod("print", "student_s4",
+           function(x) {
+               cat("Student Name:", x@name, "\n")
+               cat("Age:", x@age, "\n")
+               cat("GPA:", x@GPA, "\n")
+           })
> print(s4_obj)


#1. Import Assignment 6 Data

#Read in dataframe
> student6 <- read.table(file.choose(), header = TRUE, stringsAsFactors = FALSE)

#inspect dataframe
> head(student6)

#install plyr
> install.packages("plyr")

#load plyr
> library(plyr)

#compute mean grade by sex
#At first, I got an error message that "Sex" not found. I was able to troubleshoot this by turning header to FALSE and defining the column names
> student6 <- read.csv(
+   text = student6$Name.Age.Sex.Grade,
+   header = FALSE,
+   col.names = c("Name", "Age", "Sex", "Grade")
+ )

#After this troubleshoot, I can find the grade averages by sex.
> gender_mean <- ddply(
+   student6,
+   "Sex",
+   summarise,
+   GradeAverage = mean(Grade, na.rm = TRUE)
+ )

#Write gender means into a text file
> write.table(
+   gender_mean,
+   file = "gender_mean.txt",
+   sep  = "\t",
+   row.names = FALSE
+ )

#2. Filter names containing "i"
> i_students <- subset(
+   student6,
+   grepl("i", Name, ignore.case = TRUE)
+ )

#write output to csv
write.csv(
  i_students$Name,
  file      = "i_students.csv",
  row.names = FALSE,
  quote     = FALSE
)

#3. export filtered dataset
write.csv(
  i_students,
  file      = "i_students_full.csv",
  row.names = FALSE
)


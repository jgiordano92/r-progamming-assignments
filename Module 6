#1. Matrix addition and subtraction

#First, I will define A and B

> A <- matrix(c(2, 0, 1, 3), ncol = 2)
> B <- matrix(c(5, 2, 4, -1), ncol = 2)

#Below displays both matrices
> A
     [,1] [,2]
[1,]    2    1
[2,]    0    3
> B
     [,1] [,2]
[1,]    5    4
[2,]    2   -1

#I will add matrices. You will see that the top left is 7, which is the sum of the top left from matrix A (2) and matrix B (5)
> A+B
     [,1] [,2]
[1,]    7    5
[2,]    2    2

#I will subtract matrices. You will see that the top left is -3, which is the difference between matrix A (2) and matrix B (5)
> A-B
     [,1] [,2]
[1,]   -3   -3
[2,]   -2    4

#2. Create a diagonal matrix

#I define and display D. All matrix values except those along the diagonal are 0
> D <- diag(c(4, 1, 2, 3))
> D
     [,1] [,2] [,3] [,4]
[1,]    4    0    0    0
[2,]    0    1    0    0
[3,]    0    0    2    0
[4,]    0    0    0    3

#3. Construct a custom 5x5 matrix

#The matrix I am assigned to define consists of a diagonal of 3 as well as one row [,1] of value 2 and one column [1,] of value 1

#I first create the diagonal of 3, repeating 5 times (saved to variable named "Custom")
> Custom <- diag(3, 5)

#I then assign all values in row [1,] as 1. Note that the value in [1,1] is indeed being changed from 3 (correct) to 1(incorrect). This is to simplify the code and will be corrected in the next line of code
> Custom[1, ] <- 1

#I then replace all values in column [,1] with the correct values (3, 2, 2, 2, 2)
> Custom[, 1] <- c(3, 2, 2, 2, 2)

#Display Custom
> Custom
     [,1] [,2] [,3] [,4] [,5]
[1,]    3    1    1    1    1
[2,]    2    3    0    0    0
[3,]    2    0    3    0    0
[4,]    2    0    0    3    0
[5,]    2    0    0    0    3

